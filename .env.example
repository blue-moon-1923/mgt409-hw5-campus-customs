# Copy this file to .env in this folder and fill in your own value.
# .env is ignored by git and must never be committed.

# Required. Portkey gateway key, used for every agent call.
PORTKEY_API_KEY=your-key-here

# Optional overrides. These are the defaults the app uses.
# Only the gpt-6 family is permitted for this assignment, and the agents run at
# low reasoning effort and low verbosity to keep token use down.
MODEL_NAME=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
